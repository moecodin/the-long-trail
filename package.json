{
  "name": "the-long-trail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --mode preview --outDir dist-preview && node tools/pack-preview-models.mjs dist-preview",
    "preview": "vite preview --host",
    "music": "node tools/render-beepbox.mjs music/lantern-wakes-v1.txt public/audio/lantern-wakes-v1"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "beepbox": "4.2.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
