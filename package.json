{
  "name": "the-long-trail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && vite build --mode preview --outDir dist-preview && node tools/pack-preview-models.mjs dist-preview",
    "preview": "vite preview --host",
    "music": "node tools/render-beepbox.mjs music/lantern-wakes-v1.txt public/audio/lantern-wakes-v1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.180.0",
    "beepbox": "4.2.0",
    "fbx2gltf": "^0.9.7-p1",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
